cabal-version: 3.0
name: math-dictionary
version: 0.1.0.0
synopsis: Um dicionário de fórmulas matemáticas implementado em Haskell.
description: Este projeto contém módulos para Geometria, Álgebra e Estatística.
license: MIT
author: Nagato09-dev
maintainer: gabriel@example.com

executable math-dictionary
  main-is: Main.hs
  hs-source-dirs: src
  other-modules:
      Geometry
      Algebra
      Statistics
  build-depends:
      base >= 4.7 && < 5
  default-language: Haskell2010
